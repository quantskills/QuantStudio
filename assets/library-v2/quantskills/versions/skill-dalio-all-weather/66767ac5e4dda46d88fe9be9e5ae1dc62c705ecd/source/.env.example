# 推荐复制为用户级 ~/.pandadata.env，不要在技能目录保存真实凭证
# 必填：由 PandaData 数据服务方提供并维护的受信 HTTPS 地址；HTTP 会被拒绝
PANDADATA_BASE_URL=https://provider-assigned-pandadata.example

# 二选一：短期令牌优先；令牌到期后重新启动命令并重新认证
# PANDADATA_TOKEN=your_short_lived_token

# 或使用账号密码换取进程内令牌
# PANDADATA_USER=your_account
# PANDADATA_PASSWORD=your_password_here

# 可选：磁盘缓存路径（默认 ~/.newmax/allw_cache）
# ALLW_CACHE=/path/to/cache

# 可选：输出目录
# ALLW_OUT=./outputs/dalio_all_weather

# 可选：把"今天"固定成某个日期，便于复现（YYYYMMDD）
# ALLW_TODAY=20260710

+
+	/** Delete the actual log after teardown and the per-session write queue drain. */
+	async deleteSession(id) {
+		if (this.ctx.sessions.get(id)) throw new Error("cannot delete an attached session");
+		await this.coordinator.waitForRetirement(id);
+		return this.coordinator.serialize(id, async () => {
+			if (this.ctx.sessions.get(id)) throw new Error("session became attached during deletion");
+			this.coordinator.preparations.assertWritable(id);
+			const path = await this.findLog(id);
+			if (path !== undefined) {
+				const [root, target] = await Promise.all([realpath(this.root), realpath(path)]);
+				const inside = relative(root, target);
+				if (!inside || inside.startsWith("..") || isAbsolute(inside)) throw new Error("session log is outside persistence root");
+				await rm(path);
+			}
+			this.coordinator.preparations.invalidate(id);
+			this.coordinator.states.delete(id);
+		});
+	}
 	create(meta) {
 		return this.coordinator.create(meta);
 	}

+        await rm(pending);
+      },
+    };
+  } catch (error) {
+    if (published) await restore(); // Keep the marker: the interrupted install still needs a stopped-profile repair.
+    throw error;
+  } finally {
+    // Created by mkdtemp above; never a user-supplied cleanup target.
+    await rm(stage, { recursive: true, force: true });
+  }
+}
+
+/** Called exclusively through the official operations module, under its Profile lock. */
+export async function recoverQsPluginTransaction(context, options, environment) {
+  const dir = context.dir, pending = join(dir, transactionFile);
+  const journalText = await optional(pending);
+  if (journalText === undefined) return { recovered: false };
+  const journal = JSON.parse(journalText);
+  const names = ['package.json', 'pnpm-lock.yaml'];
+  if (journal.schemaVersion !== 1 || journal.phase !== 'publishing' || !journal.original || !journal.nextHashes
+    || Object.keys(journal.original).some(name => !names.includes(name))
+    || typeof journal.original['package.json'] !== 'string'
+    || names.some(name => !/^[a-f0-9]{64}$/.test(journal.nextHashes[name] ?? '')
+      || (journal.original[name] !== undefined && typeof journal.original[name] !== 'string'))) {
+    throw new Error('Unknown plugin recovery journal; no files were changed.');
+  }
+  JSON.parse(journal.original['package.json']); lock(journal.original['pnpm-lock.yaml']);
+  const launchPath = join(context.home, 'quantskills/application/launch.lock');
+  await mkdir(dirname(launchPath), { recursive: true });
+  const launch = await open(launchPath, 'wx', 0o600);
+  try {
+    await launch.writeFile(JSON.stringify({ pid: process.pid, purpose: 'plugin-recovery' })); await launch.sync();
+    const current = {};
+    for (const name of names) {
+      current[name] = await optional(join(dir, name));
+      if (current[name] !== journal.original[name] && (current[name] === undefined || digest(current[name]) !== journal.nextHashes[name])) {
+        throw new Error('Profile changed after the interrupted operation; preserve these edits before recovery.');
+      }
+    }
+    const retained = await mkdtemp(join(dir, '.qs-plugin-recovery-'));
+    await writeFile(join(retained, 'journal.json'), journalText, { flag: 'wx', mode: 0o600 });
+    for (const name of names) {
+      if (current[name] !== undefined) await writeFile(join(retained, name), current[name], { flag: 'wx', mode: 0o600 });
+      if (journal.original[name] === undefined) await rm(join(dir, name), { force: true });
+      else await writeFileAtomic(join(dir, name), journal.original[name], { mode: 0o600 });
+    }
+    const result = await execa(options.command ?? 'pnpm', [...options.args ?? [], 'install',
+      journal.original['pnpm-lock.yaml'] === undefined ? '--config.lockfile=false' : '--frozen-lockfile',
+      '--ignore-scripts', '--ignore-pnpmfile', '--ignore-workspace'], {
+      cwd: dir, env: environment, extendEnv: false, windowsHide: true, reject: false,
+      stdin: 'ignore', timeout: options.idleTimeoutMs ?? 120000,
+    });
+    if (result.exitCode !== 0) throw new Error('Plugin recovery could not restore installed modules; the startup block remains.');
+    await rm(pending);
+    return { recovered: true, preserved: true };
+  } finally { await launch.close(); await rm(launchPath); }
+}

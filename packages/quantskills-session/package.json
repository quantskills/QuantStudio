{
  "name": "@deepseek-ai/dsh-quantskills-session",
  "description": "Exact-version QuantSkills Skill and user Agent session composition with Host-owned archives",
  "version": "0.1.19",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantskills/QuantStudio.git",
    "directory": "packages/quantskills-session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./contracts": {
      "types": "./lib/types/contest-contract.d.ts",
      "default": "./lib/types/contest-contract.js"
    },
    "./display": {
      "types": "./lib/types/capability-display.d.ts",
      "default": "./lib/types/capability-display.js"
    },
    "./model-policy": {
      "types": "./lib/types/model-policy.d.ts",
      "default": "./lib/model-policy.js"
    }
  },
  "files": [
    "fly-runtime",
    "lib/index.js",
    "lib/types-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/model-policy.js"
  ],
  "license": "GPL-3.0-or-later OR LicenseRef-PandaAI-Commercial",
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "mustache": "4.2.0",
    "officeparser": "7.3.0",
    "zod": "^4.4.3"
  },
